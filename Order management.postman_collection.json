{
  "info": {
    "_postman_id": "1f9f1638-8339-46c8-8f5f-22441779ade0",
    "name": "Order management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "47421025",
