        {
          "name": "Get single product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log(pm.collectionVariables.get('productId'));\r\n\r\npm.test(\"Status code is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst response = pm.response.json();\r\nconsole.log(response);\r\n\r\npm.test(\"Response is an object\", () => {\r\npm.expect(response).to.be.an('object');\r\n});\r\n\r\npm.test('Coorect product was retrieved', () =>{\r\n    const requestedProductId = pm.variables.get('productId');\r\n    console.log(requestedProductId);\r\n    pm.expect(response.id).to.eql(requestedProductId);\r\n});\r\n\r\npm.test(\"check product name\", () =>\r\n{\r\n    pm.expect(response.name).to.eql('Don Francisco Colombia Supremo Medium Roast')\r\n    pm.expect(response.name).to.be.a('string')\r\n});\r\n\r\npm.test(\"check product price\", () =>\r\n{\r\n    pm.expect(response.price).to.be.a('number');\r\n    pm.expect(response.price).to.be.greaterThanOrEqual (0);\r\n});\r\n\r\n\r\npm.test(\"check product stock\", () =>\r\n{\r\n    pm.expect(response.inStock).to.be.true;\r\n});"
                ]
              }
