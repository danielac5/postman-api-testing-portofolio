            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"At least one available product exist\",() =>{\r\nconst response = pm.response.json();\r\n\r\npm.expect(response).to.be.a('array');\r\npm.expect(response.length).to.be.above(0);\r\n\r\nconst product = response[0];\r\n\r\npm.expect(product).to.be.an('object');\r\npm.expect(product).to.haveOwnProperty('id');\r\npm.expect(product.id).to.be.a('number');\r\npm.expect(product.inStock).to.be.true;\r\n\r\npm.environment.set('productId', product.id);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/products?category=coffee&results=5&available=true",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "coffee"
                },
                {
                  "key": "results",
                  "value": "5"
                },
                {
                  "key": "available",
                  "value": "true"
                }
              ]
            }
